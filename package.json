{
  "name": "cypher",
  "version": "1.0.0",
  "description": "Vault-grounded chat and semantic search for Obsidian using OpenAI-compatible APIs",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "typecheck": "tsc --noEmit -skipLibCheck && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vector-search",
    "embeddings",
    "rag",
    "openai",
    "ollama",
    "orama"
  ],
  "author": "Abderrahim Rhitrif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abderrahimrhitrif/cypher.git"
  },
  "bugs": {
    "url": "https://github.com/abderrahimrhitrif/cypher/issues"
  },
  "homepage": "https://github.com/abderrahimrhitrif/cypher#readme",
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
