{
  "name": "cypher",
  "version": "1.0.0",
  "description": "Local vector search and embeddings for your Obsidian vault using OpenAI-compatible APIs",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "npx tsx tests/test-pipeline.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vector-search",
    "embeddings",
    "ai",
    "openai",
    "orama"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
